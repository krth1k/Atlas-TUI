
# .gitignore for Atlas-TUI
# Ignore common Python artifacts, virtualenvs, IDE files, and build output

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# PyInstaller
*.manifest
*.spec

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*,cover

# Sphinx documentation
docs/_build/

# Type checkers / caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/

# IDEs and editors
.vscode/
.idea/
*.sublime-*
*.code-workspace

# OS generated files
.DS_Store
Thumbs.db

# Environment variables / secrets
.env
.env.*
!.env.example
.secrets/
secrets.yml
credentials.json

# Logs and local DBs
*.log
*.sqlite3
*.db

# Node / frontend (if present)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/

# Docker overrides
docker-compose.override.yml
docker-compose.*.yml

# Misc caches and temp files
.cache/
*.egg
*.orig
*.rej

# Ruff cache
.ruff_cache/